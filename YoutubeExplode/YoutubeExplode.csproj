<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsTrimmable
      Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))"
      >true</IsTrimmable
    >
    <IsAotCompatible
      Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))"
      >true</IsAotCompatible
    >
    <!-- Suppress Lazy attribute resolution errors from AntiHruk code generator -->
    <NoWarn>$(NoWarn);CS0246</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Description>
      Abstraction layer over YouTube's internal API.
    </Description>
    <PackageIcon>favicon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CheckUpstreamYoutubeExplode Condition="'$(CheckUpstreamYoutubeExplode)' == ''"
      >true</CheckUpstreamYoutubeExplode
    >
    <YoutubeExplodeUpstreamUrl Condition="'$(YoutubeExplodeUpstreamUrl)' == ''"
      >https://github.com/Tyrrrz/YoutubeExplode</YoutubeExplodeUpstreamUrl
    >
  </PropertyGroup>

  <ItemGroup>
    <None Include="../favicon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Binternal" />
    <PackageReference Include="CSharpier.MsBuild" />
    <PackageReference Include="JsonExtensions" />
    <PackageReference Include="Lazy.Fody" />
    <PackageReference Include="PolyShim" />
    <PackageReference Include="PowerKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiHruk\AntiHruk.csproj" />
  </ItemGroup>

  <Target
    Name="CheckUpstreamYoutubeExplodeUpdates"
    BeforeTargets="Build"
    Condition="'$(CheckUpstreamYoutubeExplode)' == 'true'"
  >
    <PropertyGroup>
      <YoutubeExplodeGitCheckDir>$(MSBuildProjectDirectory)</YoutubeExplodeGitCheckDir>
    </PropertyGroup>

    <Exec
      Command="git -C &quot;$(YoutubeExplodeGitCheckDir)&quot; rev-parse HEAD"
      ContinueOnError="true"
      ConsoleToMsBuild="true"
    >
      <Output TaskParameter="ExitCode" PropertyName="YoutubeExplodeLocalHeadExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="YoutubeExplodeLocalHeadLine" />
    </Exec>

    <Exec
      Command="git ls-remote $(YoutubeExplodeUpstreamUrl) HEAD"
      ContinueOnError="true"
      ConsoleToMsBuild="true"
      Condition="'$(YoutubeExplodeLocalHeadExitCode)' == '0'"
    >
      <Output TaskParameter="ExitCode" PropertyName="YoutubeExplodeUpstreamHeadExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="YoutubeExplodeUpstreamHeadLine" />
    </Exec>

    <PropertyGroup>
      <YoutubeExplodeLocalHead>@(YoutubeExplodeLocalHeadLine)</YoutubeExplodeLocalHead>
      <YoutubeExplodeUpstreamHeadRaw>@(YoutubeExplodeUpstreamHeadLine)</YoutubeExplodeUpstreamHeadRaw>
      <YoutubeExplodeUpstreamHead
        Condition="'$(YoutubeExplodeUpstreamHeadRaw)' != ''"
        >$([System.String]::Copy('$(YoutubeExplodeUpstreamHeadRaw)').Substring(0, 40))</YoutubeExplodeUpstreamHead
      >
    </PropertyGroup>

    <Exec
      Command="git -C &quot;$(YoutubeExplodeGitCheckDir)&quot; merge-base --is-ancestor $(YoutubeExplodeUpstreamHead) HEAD"
      ContinueOnError="true"
      Condition="'$(YoutubeExplodeLocalHeadExitCode)' == '0' and '$(YoutubeExplodeUpstreamHeadExitCode)' == '0' and '$(YoutubeExplodeUpstreamHead)' != ''"
    >
      <Output TaskParameter="ExitCode" PropertyName="YoutubeExplodeAncestorExitCode" />
    </Exec>

    <Warning
      Text="Не удалось проверить актуальность upstream $(YoutubeExplodeUpstreamUrl). Проверьте наличие git и доступ в сеть."
      Condition="'$(YoutubeExplodeLocalHeadExitCode)' != '0' or ('$(YoutubeExplodeUpstreamHeadExitCode)' != '0' and '$(YoutubeExplodeLocalHeadExitCode)' == '0')"
    />

    <Warning
      Text="Не удалось выполнить проверку merge-base для upstream $(YoutubeExplodeUpstreamUrl). Код: $(YoutubeExplodeAncestorExitCode). Проверьте наличие git и доступ в сеть."
      Condition="'$(YoutubeExplodeAncestorExitCode)' != '' and '$(YoutubeExplodeAncestorExitCode)' != '0' and '$(YoutubeExplodeAncestorExitCode)' != '1' and '$(YoutubeExplodeAncestorExitCode)' != '128'"
    />

    <Error
      Text="Сборка остановлена: версия форка YoutubeExplode неактуальна. Текущая ветка (локальный HEAD: $(YoutubeExplodeLocalHead)) не содержит коммит upstream $(YoutubeExplodeUpstreamHead). Форк отстаёт от оригинального репозитория $(YoutubeExplodeUpstreamUrl). Подтяните upstream и залейте изменения в ваш форк."
      Condition="'$(YoutubeExplodeAncestorExitCode)' == '1' or '$(YoutubeExplodeAncestorExitCode)' == '128'"
    />
  </Target>
</Project>
